DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.mativiglianco.cloud
CORS_ALLOWED_ORIGINS=https://api.mativiglianco.cloud,https://vales.mativiglianco.cloud,https://mativiglianco.github.io
CSRF_TRUSTED_ORIGINS=https://api.mativiglianco.cloud,https://vales.mativiglianco.cloud,https://mativiglianco.github.io
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OCR
OCR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3-flash-preview
GEMINI_THINKING_BUDGET=0
GUNICORN_TIMEOUT=240
GUNICORN_WORKERS=2

# ARCA (facturacion electronica WSFEv1)
# mock = simula sin validez fiscal | wsfe = emite contra ARCA
ARCA_PROVIDER=mock
# homologacion (prueba) | produccion (comprobantes reales)
ARCA_ENVIRONMENT=homologacion
ARCA_CUIT=
# Rutas a certificado y clave privada montados en el contenedor (nunca en el repo)
ARCA_CERT_PATH=/run/secrets/arca_cert
ARCA_KEY_PATH=/run/secrets/arca_key
# Punto de venta "RECE para aplicativo y web services"
ARCA_DEFAULT_POINT_OF_SALE=4
# 6 = Factura B (consumidor final) para cupones de posnet
ARCA_GETNET_VOUCHER_TYPE=6
ARCA_DEFAULT_VAT_RATE=10.5
